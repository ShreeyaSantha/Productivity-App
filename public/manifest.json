{
  "manifest_version": 3,
  "name": "Productivity Help",
  "version": "1.0.1",
  "description": "Helps with your Productivity",
  "icons": {
    "16": "icons/Coffee16.png",
    "32": "icons/Coffee32.png",
    "48": "icons/Coffee48.png",
    "128": "icons/Coffee128.png"
  }, 
  "permissions": [
    "activeTab"
  ],
  "optional_host_permissions":[
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "index.html"
  }
}
